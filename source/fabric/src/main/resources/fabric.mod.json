{
  "schemaVersion": 1,
  "id": "mca",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ancientkira.mca.fabric.MCAFabric"
    ],
    "client": [
      "com.ancientkira.mca.fabric.MCAFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.classtweaker",
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "",
        "modmenu.wiki": "https://github.com/AncientKira21/mcarem/wiki"
      }
    }
  },
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "*",
    "mixinextras": ">=0.5.5",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
  }
}
